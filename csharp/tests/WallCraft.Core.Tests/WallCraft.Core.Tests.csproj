<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lanceur de tests sans paquet NuGet : dotnet run (option project) tests/WallCraft.Core.Tests [filtre] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WallCraft.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WallCraft.Core\WallCraft.Core.csproj" />
    <None Include="..\fixtures\**\*.json" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
