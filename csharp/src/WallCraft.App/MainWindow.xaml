<Window
    x:Class="WallCraft.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:WallCraft.App.Controls"
    xmlns:vm="using:WallCraft.App.ViewModels"
    Title="WallCraft Pro">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Textes posés par ApplyTexts() (ressources .resw, langue changeable à chaud). -->
    <controls:CursorGrid x:Name="RootGrid" RequestedTheme="Dark" AllowDrop="True" Background="Transparent"
                         DragOver="OnDragOver" Drop="OnDrop">
        <controls:CursorGrid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </controls:CursorGrid.RowDefinitions>

        <!-- Barre de titre étendue : icône, menus, puis zone de déplacement avec le titre -->
        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="18" Height="18" Margin="14,0,6,0" VerticalAlignment="Center" />
            <MenuBar x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center">
                <MenuBarItem x:Name="FileMenu">
                    <MenuFlyoutItem x:Name="NewProjectItem" Command="{x:Bind ViewModel.NewProjectCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnAcceleratorInvoked" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="OpenProjectItem" Command="{x:Bind ViewModel.OpenProjectCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnAcceleratorInvoked" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="SaveProjectItem" Command="{x:Bind ViewModel.SaveProjectCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnAcceleratorInvoked" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="AddImagesItem" Command="{x:Bind ViewModel.AddImagesCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExportItem" Command="{x:Bind ViewModel.ExportImageCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnAcceleratorInvoked" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="SplitItem" Command="{x:Bind ViewModel.ExportSplitCommand}" />
                    <MenuFlyoutItem x:Name="ApplyItem" Command="{x:Bind ViewModel.ApplyWallpaperCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="QuitItem" Click="OnQuitClick" />
                </MenuBarItem>
                <MenuBarItem x:Name="ImageMenu">
                    <MenuFlyoutItem x:Name="RotateItem" Command="{x:Bind ViewModel.RotateCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnAcceleratorInvoked" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="AdjustItem" Command="{x:Bind ViewModel.AdjustCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="BringForwardItem" Command="{x:Bind ViewModel.BringForwardCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="SendBackwardItem" Command="{x:Bind ViewModel.SendBackwardCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="RemoveItem" Command="{x:Bind ViewModel.RemoveCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" Invoked="OnAcceleratorInvoked" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Name="ScreensMenu">
                    <MenuFlyoutItem x:Name="PhysicalItem" Command="{x:Bind ViewModel.PhysicalSizeCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FB;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="PrefsItem" Click="OnAutomationPrefsClick">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="RedetectItem" Command="{x:Bind ViewModel.RedetectScreensCommand}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Name="LanguageMenu" />
            </MenuBar>
            <Grid x:Name="TitleBarDrag" Grid.Column="2" Background="Transparent">
                <TextBlock x:Name="TitleText" Margin="16,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>

        <!-- Barre d'outils sur une ligne : images | disposition | cadrage ............ Appliquer -->
        <Grid Grid.Row="1" Margin="12,0,12,10" Padding="10,8" CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.AddImagesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="AddImagesText" />
                    </StackPanel>
                </Button>
                <AppBarSeparator />
                <TextBlock x:Name="LayoutLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="LayoutCombo" MinWidth="190" VerticalAlignment="Center" SelectionChanged="OnLayoutSelectionChanged" />
                <Button Command="{x:Bind ViewModel.AutoArrangeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                        <TextBlock x:Name="AutoArrangeText" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.VariantsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock x:Name="VariantsText" />
                    </StackPanel>
                </Button>
                <AppBarSeparator />
                <TextBlock x:Name="FitLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <ToggleButton x:Name="FitButton" Click="OnFitClick" CornerRadius="4,0,0,4" />
                    <ToggleButton x:Name="FillButton" Click="OnFillClick" CornerRadius="0,4,4,0" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"
                    Command="{x:Bind ViewModel.ApplyWallpaperCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                    <TextBlock x:Name="ApplyText" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="12,0,12,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Bibliothèque -->
            <Grid CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="14,12,14,8">
                    <TextBlock x:Name="LibraryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LibraryCountText, Mode=OneWay}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Name="LibraryList" Grid.Row="1" Padding="4,0" SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.LibraryItems}" SelectionChanged="OnLibrarySelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryItemViewModel">
                            <Grid ColumnSpacing="10" Padding="0,6" ToolTipService.ToolTip="{x:Bind FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="76" Height="48" CornerRadius="4" Background="#0D1524">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" FontSize="13" />
                                    <TextBlock Text="{x:Bind Resolution}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind LowResText, Mode=OneWay}" Visibility="{x:Bind LowResVisibility, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="LibraryEmptyText" Grid.Row="1" Margin="18" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" />
                <StackPanel Grid.Row="2" Margin="12,8,12,12" Spacing="6">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SendBackwardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                <TextBlock x:Name="SendBackwardText" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.BringForwardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                <TextBlock x:Name="BringForwardText" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RotateCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7AD;" FontSize="12" />
                                <TextBlock x:Name="RotateText" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AdjustCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE790;" FontSize="12" />
                                <TextBlock x:Name="AdjustText" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- Action destructive : à part, en bas, en couleur d'alerte -->
                    <Button HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{x:Bind ViewModel.RemoveCommand}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock x:Name="RemoveText" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Zone de travail : Composition | Aperçu sur les écrans -->
            <Grid Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,6,10,6" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="ViewSelector" SelectionChanged="OnViewSelectionChanged">
                        <SelectorBarItem x:Name="ComposeTab" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE70F;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="PreviewTab">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE7F4;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ToggleButton x:Name="MoveToolButton" Click="OnToolClick" CornerRadius="4,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C2;" FontSize="12" />
                                <TextBlock x:Name="MoveToolText" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ScaleToolButton" Click="OnToolClick" CornerRadius="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE740;" FontSize="12" />
                                <TextBlock x:Name="ScaleToolText" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="CropToolButton" Click="OnToolClick" CornerRadius="0,4,4,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A8;" FontSize="12" />
                                <TextBlock x:Name="CropToolText" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock x:Name="PreviewHintText" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <CheckBox x:Name="ShowMonitorsCheck" Grid.Column="2" IsChecked="True" MinWidth="0" Click="OnShowMonitorsClick" />
                </Grid>
                <controls:CursorGrid x:Name="StageHost" Grid.Row="1" Margin="10,0,10,10" CornerRadius="6" Background="#09111F">
                    <canvas:CanvasControl x:Name="CompositionCanvas" UseSharedDevice="True" IsTabStop="True"
                                          Draw="OnCompositionDraw" CreateResources="OnCreateResources"
                                          SizeChanged="OnCompositionSizeChanged"
                                          PointerPressed="OnStagePointerPressed" PointerMoved="OnStagePointerMoved"
                                          PointerReleased="OnStagePointerReleased" PointerCaptureLost="OnStagePointerCaptureLost"
                                          PointerWheelChanged="OnStagePointerWheelChanged" />
                    <canvas:CanvasControl x:Name="PreviewCanvas" UseSharedDevice="True" Visibility="Collapsed"
                                          Draw="OnPreviewDraw" CreateResources="OnCreateResources"
                                          SizeChanged="OnPreviewSizeChanged" />
                </controls:CursorGrid>
            </Grid>
        </Grid>

        <!-- Barre d'état -->
        <Grid Grid.Row="3" Padding="12,4" ColumnSpacing="12" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="SelectionTextBlock" Grid.Column="1" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton x:Name="KofiLink" Grid.Column="3" Padding="6,2" FontSize="12" Click="OnKofiClick" />
        </Grid>
    </controls:CursorGrid>
</Window>
