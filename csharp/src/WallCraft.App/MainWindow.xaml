<Window
    x:Class="WallCraft.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WallCraft Pro">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="WallCraft Pro" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <TextBlock x:Name="DisplayNameText" Grid.Row="1" Text="WallCraft Pro"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource TitleTextBlockStyle}" />
    </Grid>
</Window>
