<Project Sdk="Microsoft.NET.Sdk">
  <!-- Coquille WinUI 3 non empaquetée et autonome (aucune installation de .NET ni du Windows App SDK). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WallCraft.App</RootNamespace>
    <AssemblyName>WallCraft</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>fr-FR</DefaultLanguage>
    <!-- Taille de l'exe : fichier unique compressé, seulement les langues de l'interface. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;fr;es;de</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\WallCraft.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallCraft.Core\WallCraft.Core.csproj" />
    <ProjectReference Include="..\WallCraft.Platform.Windows\WallCraft.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Icône de la fenêtre : à côté de l'exe (hors du fichier unique) pour AppWindow.SetIcon. -->
  <ItemGroup>
    <Content Include="Assets\WallCraft.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Version Microsoft Store : paquet MSIX (WindowsPackageType=MSIX, voir .github/workflows/store.yml).
       Icônes du paquet générées par tools/make_msix_assets.py ; pas de fichier unique dans un paquet. -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <PublishSingleFile>false</PublishSingleFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <Content Include="Images\*.png" />
  </ItemGroup>

  <!-- Traductions : Strings\(langue)\Resources.resw, inclus automatiquement par le SDK (générés par tools/export_resw.py). -->
</Project>
