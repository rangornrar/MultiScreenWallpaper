<Project Sdk="Microsoft.NET.Sdk">
  <!-- Intégration Windows : fond d'écran (COM), EDID, surveillance des écrans, démarrage auto, visages, rendu HD. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WallCraft.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WallCraft.Core\WallCraft.Core.csproj" />
  </ItemGroup>
</Project>
